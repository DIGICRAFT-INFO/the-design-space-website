# ── Hostinger Production Environment ─────────────────────────────────────────
# Backend : https://api.thedesignspace.in
# Frontend: https://thedesignspace.in
# Copy this file to .env on the Hostinger server and fill in real values.

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_TO_STRONG_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_TO_DIFFERENT_STRONG_RANDOM_64_CHAR_HEX

# CORS — allow only production frontend
FRONTEND_URL=https://thedesignspace.in,https://www.thedesignspace.in
CORS_ORIGIN=https://thedesignspace.in,https://www.thedesignspace.in

# Backend public URL
BACKEND_URL=https://api.thedesignspace.in

# Brand
FIRM_NAME=The Design Space

# WhatsApp Business API (Meta)
WA_PHONE_NUMBER_ID=your_meta_phone_id
WA_ACCESS_TOKEN=your_meta_permanent_token
WA_VERIFY_TOKEN=your_custom_verify_token

# Email (Gmail App Password)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx

# Cloudinary — persistent image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Skip Puppeteer Chromium (not needed — PDFKit is used instead)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
