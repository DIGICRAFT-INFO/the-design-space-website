<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 12px;
      color: #333;
      line-height: 1.5;
      padding: 40px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 30px;
      border-bottom: 3px solid <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
      padding-bottom: 20px;
    }
    .company-name {
      font-size: 22px;
      font-weight: 700;
      color: <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
    }
    .company-meta {
      font-size: 11px;
      color: #666;
      margin-top: 4px;
      max-width: 300px;
    }
    .doc-title {
      text-align: right;
    }
    .doc-title h1 {
      font-size: 28px;
      font-weight: 700;
      color: #333;
      letter-spacing: 1px;
    }
    .doc-title .quote-number {
      font-size: 13px;
      color: #666;
      margin-top: 4px;
    }
    .meta-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 30px;
    }
    .meta-box {
      width: 48%;
    }
    .meta-box h3 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888;
      margin-bottom: 6px;
      border-bottom: 1px solid #eee;
      padding-bottom: 4px;
    }
    .meta-box p {
      font-size: 12px;
      margin-bottom: 3px;
    }
    .meta-box .label {
      color: #888;
      display: inline-block;
      width: 110px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }
    thead th {
      background: <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
      color: #fff;
      padding: 10px 12px;
      text-align: left;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    thead th.right { text-align: right; }
    tbody td {
      padding: 9px 12px;
      border-bottom: 1px solid #eee;
      font-size: 12px;
    }
    tbody td.right { text-align: right; }
    tbody tr:nth-child(even) { background: #fafafa; }
    .totals-section {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 30px;
    }
    .totals-table {
      width: 320px;
    }
    .totals-table table {
      margin-bottom: 0;
    }
    .totals-table td {
      padding: 7px 12px;
      border-bottom: 1px solid #eee;
    }
    .totals-table td:first-child { color: #666; }
    .totals-table td:last-child { text-align: right; font-weight: 500; }
    .totals-table tr.grand-total td {
      background: <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      border-bottom: none;
    }
    .scope-heading {
      font-size: 13px;
      font-weight: 700;
      color: <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .terms-section {
      margin-top: 20px;
      padding: 15px;
      background: #f9f9f9;
      border-left: 3px solid <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
    }
    .terms-section h4 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888;
      margin-bottom: 8px;
    }
    .terms-section ol {
      padding-left: 16px;
    }
    .terms-section ol li {
      font-size: 11px;
      color: #555;
      margin-bottom: 3px;
    }
    .notes-section {
      margin-top: 20px;
      padding: 15px;
      background: #f9f9f9;
      border-left: 3px solid <%= brand && brand.primary_color ? brand.primary_color : '#C8922A' %>;
    }
    .notes-section h4 {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #888;
      margin-bottom: 6px;
    }
    .notes-section p {
      font-size: 12px;
      color: #555;
    }
    .footer {
      margin-top: 40px;
      text-align: center;
      font-size: 10px;
      color: #999;
      border-top: 1px solid #eee;
      padding-top: 15px;
    }
    .status-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
    }
    .status-draft    { background: #f0f0f0; color: #666; }
    .status-sent     { background: #e3f2fd; color: #1565c0; }
    .status-approved { background: #e8f5e9; color: #2e7d32; }
    .status-rejected { background: #ffebee; color: #c62828; }
    .status-superseded { background: #f3f4f6; color: #6b7280; }
  </style>
</head>
<body>

  <!-- ── HEADER: Company info + QUOTATION title ── -->
  <div class="header">
    <div style="display: flex; align-items: center; gap: 15px;">
      <% if (logo_base64) { %>
        <img src="<%= logo_base64 %>" alt="Logo" style="height: 60px; width: auto; object-fit: contain;">
      <% } %>
      <div>
        <% if (brand && brand.firm_name) { %>
          <div class="company-name"><%= brand.firm_name %></div>
        <% } else { %>
          <div class="company-name">The Design Space</div>
        <% } %>
        <% if (brand && brand.tagline) { %>
          <div class="company-meta"><%= brand.tagline %></div>
        <% } %>
        <% if (brand && brand.firm_address) { %>
          <div class="company-meta"><%= brand.firm_address %></div>
        <% } %>
        <% if (brand && (brand.firm_phone || brand.firm_email)) { %>
          <div class="company-meta">
            <%= brand.firm_phone || '' %><%= brand.firm_phone && brand.firm_email ? ' · ' : '' %><%= brand.firm_email || '' %>
          </div>
        <% } %>
        <% if (tax_cfg && tax_cfg.firm_gstin) { %>
          <div class="company-meta">GSTIN: <%= tax_cfg.firm_gstin %></div>
        <% } %>
      </div>
    </div>
    <div class="doc-title">
      <h1>QUOTATION</h1>
      <div class="quote-number"><%= quotation.quote_number %> (v<%= quotation.version %>)</div>
    </div>
  </div>

  <!-- ── META: Prepared For + Quotation Details ── -->
  <div class="meta-section">
    <div class="meta-box">
      <h3>Prepared For</h3>
      <% const client = quotation.project && quotation.project.client ? quotation.project.client : null; %>
      <% if (client) { %>
        <p><span class="label">Client:</span> <strong><%= client.full_name %></strong></p>
        <% if (client.email) { %>
          <p><span class="label">Email:</span> <%= client.email %></p>
        <% } %>
        <% if (client.phone) { %>
          <p><span class="label">Phone:</span> <%= client.phone %></p>
        <% } %>
        <% if (client.billing_address) { %>
          <p><span class="label">Address:</span> <%= client.billing_address %></p>
        <% } else if (client.site_address) { %>
          <p><span class="label">Address:</span> <%= client.site_address %></p>
        <% } %>
        <% if (client.city || client.state) { %>
          <p><span class="label"></span> <%= [client.city, client.state, client.country].filter(Boolean).join(', ') %></p>
        <% } %>
        <% if (client.gstin) { %>
          <p><span class="label">GSTIN:</span> <%= client.gstin %></p>
        <% } %>
      <% } %>
      <% if (quotation.project) { %>
        <p style="margin-top:6px;"><span class="label">Project:</span> <%= quotation.project.name %></p>
      <% } %>
    </div>

    <div class="meta-box">
      <h3>Quotation Details</h3>
      <p><span class="label">Ref #:</span> <strong><%= quotation.quote_number %></strong></p>
      <p><span class="label">Date:</span> <%= new Date(quotation.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></p>
      <% if (quotation.valid_until) { %>
        <p><span class="label">Valid Until:</span> <strong><%= new Date(quotation.valid_until).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong></p>
      <% } else { %>
        <p><span class="label">Valid Until:</span> —</p>
      <% } %>
      <p><span class="label">Status:</span> <span class="status-badge status-<%= quotation.status %>"><%= quotation.status.toUpperCase() %></span></p>
    </div>
  </div>

  <!-- ── LINE ITEMS ── -->
  <div class="scope-heading">Scope of Work &amp; Pricing</div>
  <table>
    <thead>
      <tr>
        <th style="width:30px">#</th>
        <th>Description / Service</th>
        <th>Category</th>
        <th class="right" style="width:50px">Qty</th>
        <th class="right" style="width:50px">Unit</th>
        <th class="right" style="width:110px">Rate (Rs.)</th>
        <th class="right" style="width:110px">Amount (Rs.)</th>
      </tr>
    </thead>
    <tbody>
      <% if (items && items.length > 0) { %>
        <% items.forEach(function(item, index) { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= item.description %></td>
            <td><%= item.category || '—' %></td>
            <td class="right"><%= item.quantity %></td>
            <td class="right"><%= item.unit || '—' %></td>
            <td class="right"><%= Number(item.rate).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
            <td class="right"><%= Number(item.amount || (item.quantity * item.rate)).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="7" style="text-align:center; color:#999; padding:20px;">No items</td></tr>
      <% } %>
    </tbody>
  </table>

  <!-- ── TOTALS ── -->
  <div class="totals-section">
    <div class="totals-table">
      <table>
        <tr>
          <td>Subtotal</td>
          <td>Rs. <%= Number(quotation.subtotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
        <% if (Number(quotation.discount_amount) > 0) { %>
        <tr>
          <td>Discount (<%= quotation.discount_type === 'percentage' ? quotation.discount_value + '%' : 'Fixed' %>)</td>
          <td>- Rs. <%= Number(quotation.discount_amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
        <% } %>
        <tr>
          <td>Taxable Amount</td>
          <td>Rs. <%= Number(quotation.taxable_amount || quotation.subtotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
        <% if (Number(quotation.cgst_amount) > 0) { %>
        <tr>
          <td>CGST @ <%= quotation.cgst_rate %>%</td>
          <td>Rs. <%= Number(quotation.cgst_amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
        <% } %>
        <% if (Number(quotation.sgst_amount) > 0) { %>
        <tr>
          <td>SGST @ <%= quotation.sgst_rate %>%</td>
          <td>Rs. <%= Number(quotation.sgst_amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
        <% } %>
        <% if (Number(quotation.igst_amount) > 0) { %>
        <tr>
          <td>IGST @ <%= quotation.igst_rate %>%</td>
          <td>Rs. <%= Number(quotation.igst_amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
        <% } %>
        <tr class="grand-total">
          <td>Grand Total</td>
          <td>Rs. <%= Number(quotation.grand_total || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
        </tr>
      </table>
    </div>
  </div>

  <!-- ── NOTES ── -->
  <% if (quotation.notes) { %>
  <div class="notes-section">
    <h4>Notes</h4>
    <p><%= quotation.notes %></p>
  </div>
  <% } %>

  <!-- ── TERMS & CONDITIONS ── -->
  <div class="terms-section">
    <h4>Terms &amp; Conditions</h4>
    <ol>
      <li>This quotation is valid until the date mentioned above.</li>
      <li>50% advance payment required to commence work.</li>
      <li>Balance payment due before final handover.</li>
      <li>Any changes to scope may result in revised quotation.</li>
      <li>All prices are inclusive of taxes as applicable.</li>
    </ol>
  </div>

  <!-- ── FOOTER ── -->
  <div class="footer">
    <p>This is a computer-generated document. | <%= brand && brand.firm_name ? brand.firm_name : 'The Design Space' %></p>
  </div>

</body>
</html>
